{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonsight.org/schema/v1/catalog.schema.json",
  "title": "Catalog",
  "description": "Terms contributed by the core and the plugins (V14). Generated by backend/bin/build-contract.php from contract/catalog/builtin.json and plugins/*/*/catalog.json; do not edit by hand.",
  "$defs": {
    "measuredQuantity": {
      "type": "string",
      "enum": [
        "waterLevel",
        "discharge",
        "doseRate"
      ]
    },
    "modelQuantity": {
      "type": "string",
      "enum": [
        "temperature",
        "airQualityIndex",
        "pollenConcentration"
      ]
    },
    "warningCategory": {
      "type": "string",
      "enum": [
        "weather",
        "civilProtection",
        "police",
        "flood"
      ]
    },
    "newsCategory": {
      "type": "string",
      "enum": [
        "weather",
        "conflict",
        "infrastructure"
      ]
    },
    "newsFeed": {
      "type": "string",
      "enum": [
        "tagesschau",
        "orf",
        "srf"
      ]
    }
  }
}
